#!/usr/bin/env bash
# banglab -- start papers from the BangLab template and keep their library files current.
#
#   ./banglab init   <paper-dir> [--version vX.Y.Z] [--force]
#       Copy the scaffold and the library of one release into a paper.
#   ./banglab status <paper-dir>...
#       Print each paper's release, how far it is behind, and any edited library file.
#   ./banglab update <paper-dir> [--version vX.Y.Z] [--force]
#       Replace a paper's library files with another release and commit the change.
#
# banglab-files.txt says which files are library (owned by the template, replaced on
# update, never edited in a paper) and which are scaffold (copied once, then the
# paper's own). A paper records its release and the hash of every library file in
# banglab.lock. Releases are the v* tags of this repository; the newest is the default.
# The tool commits inside a paper's git repository but never pushes.
set -euo pipefail

template=$(cd "$(dirname "$0")" && pwd)

die() { echo "banglab: $*" >&2; exit 1; }
note() { echo "banglab: $*"; }

latest_version() {
  local v
  v=$(git -C "$template" tag --list 'v*' --sort=-v:refname | head -n1)
  [[ -n $v ]] || die "no v* release tag in $template"
  echo "$v"
}

# True when version $1 sorts after version $2.
version_gt() { [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1) == "$1" ]]; }

# How many releases come after $1, up to and including $2.
count_between() {
  local from=$1 to=$2 tag n=0
  while read -r tag; do
    if version_gt "$tag" "$from" && ! version_gt "$tag" "$to"; then n=$((n + 1)); fi
  done < <(git -C "$template" tag --list 'v*')
  echo "$n"
}

# Unpack one release into a new temporary directory and print its path.
unpack() {
  local version=$1 dir
  git -C "$template" rev-parse -q --verify "refs/tags/$version" >/dev/null ||
    die "no release $version in $template (releases: $(git -C "$template" tag --list 'v*' | tr '\n' ' '))"
  dir=$(mktemp -d)
  git -C "$template" archive "$version" | tar -x -C "$dir"
  echo "$dir"
}

# The files of one section of a release's manifest, one relative path per line.
section_files() {
  local root=$1 section=$2 entry
  [[ -f $root/banglab-files.txt ]] || die "the release has no banglab-files.txt"
  awk -v want="[$section]" '/^\[/ { on = ($0 == want); next } on && NF && $1 !~ /^#/ { print $1 }' \
    "$root/banglab-files.txt" |
    while read -r entry; do
      if [[ $entry == */ ]]; then
        (cd "$root" && find "${entry%/}" -type f | sort)
      else
        echo "$entry"
      fi
    done
}

lock_field() { awk -v k="$2" '$1 == k { print $2; exit }' "$1/banglab.lock"; }
lock_files() { awk '$1 == "sha256" { print $3 }' "$1/banglab.lock"; }

# Library files whose content no longer matches the hash in banglab.lock.
edited_files() {
  local paper=$1
  awk '$1 == "sha256" { print $2 "  " $3 }' "$paper/banglab.lock" |
    (cd "$paper" && sha256sum --check --quiet 2>/dev/null | sed -n 's/: FAILED.*$//p') || true
}

write_lock() {
  local paper=$1 version=$2 commit=$3 root=$4 file
  {
    echo "# banglab.lock -- written by ./banglab from the BangLab paper template. Do not edit."
    echo "version $version"
    echo "commit $commit"
    section_files "$root" library | while read -r file; do
      echo "sha256 $(cd "$paper" && sha256sum "$file" | cut -d' ' -f1)  $file"
    done
  } >"$paper/banglab.lock"
}

in_git() { git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1; }

# Build a copy of the paper and print "errors=N pages=P", or say why it was not built.
build_report() {
  local paper=$1 dir log
  [[ -f $paper/main.tex ]] || { echo "not built (no main.tex)"; return; }
  command -v latexmk >/dev/null || { echo "not built (latexmk not found)"; return; }
  dir=$(mktemp -d)
  cp -r "$paper/." "$dir/"
  (cd "$dir" && latexmk -pdf -f -interaction=nonstopmode main.tex >/dev/null 2>&1) || true
  log=$dir/main.log
  if [[ -f $log ]]; then
    echo "errors=$(grep -a -c '^! ' "$log" || true) pages=$(grep -a -o 'Output written on main.pdf ([0-9]* page' "$log" | grep -o '[0-9]*' | tail -n1)"
  else
    echo "not built (no log)"
  fi
  rm -rf "$dir"
}

# Print the changelog entries after version $2 up to and including $3.
changelog_between() {
  local root=$1 from=$2 to=$3 line ver show=0
  [[ -f $root/CHANGELOG.md ]] || return 0
  while IFS= read -r line; do
    if [[ $line =~ ^##\ (v[0-9][0-9.]*) ]]; then
      ver=${BASH_REMATCH[1]}
      if version_gt "$ver" "$from" && ! version_gt "$ver" "$to"; then show=1; else show=0; fi
    fi
    if ((show)); then echo "$line"; fi
  done <"$root/CHANGELOG.md"
  return 0
}

cmd_init() {
  local paper="" version="" force=0 root file clash=()
  while (($#)); do
    case $1 in
      --version) version=${2:?--version needs a release such as v1.0.0}; shift 2 ;;
      --force) force=1; shift ;;
      -*) die "init: unknown option $1" ;;
      *) [[ -z $paper ]] || die "init takes one paper directory"; paper=$1; shift ;;
    esac
  done
  [[ -n $paper ]] || die "usage: ./banglab init <paper-dir> [--version vX.Y.Z] [--force]"
  [[ -e $paper/banglab.lock ]] && die "$paper already has banglab.lock; use ./banglab update"
  version=${version:-$(latest_version)}
  root=$(unpack "$version")
  mkdir -p "$paper"
  while read -r file; do
    [[ -e $paper/$file ]] && clash+=("$file")
  done < <(section_files "$root" scaffold; section_files "$root" library)
  if ((${#clash[@]})) && ((!force)); then
    die "these files already exist in $paper: ${clash[*]}. A blank Overleaf project has a stub main.tex; pass --force to overwrite."
  fi
  while read -r file; do
    mkdir -p "$paper/$(dirname "$file")"
    cp "$root/$file" "$paper/$file"
  done < <(section_files "$root" scaffold; section_files "$root" library)
  write_lock "$paper" "$version" "$(git -C "$template" rev-parse --short "$version^{commit}")" "$root"
  rm -rf "$root"
  note "started $paper from the template at $version"
  if in_git "$paper"; then
    git -C "$paper" add -A
    git -C "$paper" commit -q -m "Start from the BangLab paper template $version"
    note "committed in $paper; push it when you are ready"
  fi
}

cmd_status() {
  (($#)) || die "usage: ./banglab status <paper-dir>..."
  local latest paper version edited behind
  latest=$(latest_version)
  for paper in "$@"; do
    if [[ ! -f $paper/banglab.lock ]]; then
      printf '%s\tno banglab.lock, not started with ./banglab\n' "$paper"
      continue
    fi
    version=$(lock_field "$paper" version)
    behind=$(count_between "$version" "$latest")
    edited=$(edited_files "$paper" | tr '\n' ' ')
    printf '%s\t%s\t%s\t%s\n' "$paper" "$version" \
      "$( ((behind)) && echo "$behind release(s) behind $latest" || echo "up to date")" \
      "$([[ -n $edited ]] && echo "EDITED library files: $edited" || echo "library unchanged")"
  done
}

cmd_update() {
  local paper="" version="" force=0 current root file before after edited
  while (($#)); do
    case $1 in
      --version) version=${2:?--version needs a release such as v1.1.0}; shift 2 ;;
      --force) force=1; shift ;;
      -*) die "update: unknown option $1" ;;
      *) [[ -z $paper ]] || die "update takes one paper directory"; paper=$1; shift ;;
    esac
  done
  [[ -n $paper ]] || die "usage: ./banglab update <paper-dir> [--version vX.Y.Z] [--force]"
  [[ -f $paper/banglab.lock ]] || die "$paper has no banglab.lock; start papers with ./banglab init"
  current=$(lock_field "$paper" version)
  version=${version:-$(latest_version)}
  [[ $current == "$version" ]] && { note "$paper is already at $version"; return; }
  if in_git "$paper" && [[ -n $(git -C "$paper" status --porcelain) ]]; then
    die "$paper has uncommitted changes; commit them first so the update is its own commit"
  fi
  edited=$(edited_files "$paper" | tr '\n' ' ')
  if [[ -n $edited ]] && ((!force)); then
    die "library files were edited in $paper: $edited. Move those changes to commands.tex, or pass --force to discard them."
  fi
  root=$(unpack "$version")
  echo "== Changes from $current to $version"
  changelog_between "$root" "$current" "$version"
  if changelog_between "$root" "$current" "$version" | grep -q '^## .*layout-changing'; then
    echo "!! A layout-changing release is in this range: text will move and the page count can change."
  fi
  before=$(build_report "$paper")
  while read -r file; do rm -f "$paper/$file"; done < <(lock_files "$paper")
  while read -r file; do
    mkdir -p "$paper/$(dirname "$file")"
    cp "$root/$file" "$paper/$file"
  done < <(section_files "$root" library)
  write_lock "$paper" "$version" "$(git -C "$template" rev-parse --short "$version^{commit}")" "$root"
  rm -rf "$root"
  after=$(build_report "$paper")
  echo "== Build before: $before"
  echo "== Build after:  $after"
  if in_git "$paper"; then
    git -C "$paper" add -A
    git -C "$paper" commit -q -m "Update the BangLab template from $current to $version"
    note "committed in $paper; push it when you are ready"
  fi
}

case ${1:-} in
  init) shift; cmd_init "$@" ;;
  status) shift; cmd_status "$@" ;;
  update) shift; cmd_update "$@" ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
